# Base44 development defaults — placeholders so the app boots without real credentials.
# Real values are delivered via /run/base44/app.env (platform secrets) and override these.

# ── Backend ──────────────────────────────────────────────
JWT_SECRET=base44-dev-jwt-secret-placeholder
JWT_TOKEN_EXPIRATION_DAYS=30
EMAIL=placeholder@example.com
PASSWORD=placeholder-password
OTP_EXPIRATION_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=5
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_APPLICATION_CREDENTIALS=src/firebase-admin-cred.json
PRIVATE_KEY_RECOVERY_SECRET=base44-dev-recovery-secret-placeholder

# ── Frontend (server-side / private) ─────────────────────
# SESSION_SECRET must match the backend's hardcoded verifyToken secret ("helloWorld@123")
SESSION_SECRET=helloWorld@123
EMAIL=placeholder@example.com
PASSWORD=placeholder-password
PRIVATE_KEY_RECOVERY_SECRET=base44-dev-recovery-secret-placeholder

# ── Frontend (public / client-side) ──────────────────────
NEXT_PUBLIC_TENOR_API_KEY=placeholder
NEXT_PUBLIC_FIREBASE_API_KEY=placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=placeholder
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=placeholder.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=placeholder
NEXT_PUBLIC_FIREBASE_APP_ID=placeholder
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=placeholder
NEXT_PUBLIC_FIREBASE_VAPID_KEY=placeholder
